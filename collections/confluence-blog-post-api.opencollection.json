{
  "opencollection": "1.0.0",
  "info": {
    "name": "Confluence Cloud REST API v2 Attachment Blog Post API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Blog Post",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Blog Posts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.atlassian.net/wiki/api/v2/blogposts",
            "params": [
              {
                "name": "space-id",
                "value": "",
                "type": "query",
                "description": "Filter by space ID. Multiple IDs can be specified."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by content status."
              },
              {
                "name": "title",
                "value": "",
                "type": "query",
                "description": "Filter by content title. Supports exact match."
              },
              {
                "name": "body-format",
                "value": "",
                "type": "query",
                "description": "The representation format for the content body."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort order for results. Prefix with - for descending order. Supported fields include id, title, created-date, and modified-date."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Used for pagination. The cursor value is returned in the response _links.next when there are more results."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return."
              }
            ]
          },
          "docs": "Returns all blog posts. Results can be filtered by space, status, and title."
        },
        {
          "info": {
            "name": "Create Blog Post",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.atlassian.net/wiki/api/v2/blogposts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a blog post in the specified space."
        },
        {
          "info": {
            "name": "Get Blog Post by Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.atlassian.net/wiki/api/v2/blogposts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the content."
              },
              {
                "name": "body-format",
                "value": "",
                "type": "query",
                "description": "The representation format for the content body."
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "The version number of the content to retrieve."
              }
            ]
          },
          "docs": "Returns a specific blog post by id."
        },
        {
          "info": {
            "name": "Update Blog Post",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{domain}.atlassian.net/wiki/api/v2/blogposts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the content."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a blog post by id."
        },
        {
          "info": {
            "name": "Delete Blog Post",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{domain}.atlassian.net/wiki/api/v2/blogposts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the content."
              }
            ]
          },
          "docs": "Deletes a blog post by id."
        }
      ]
    }
  ],
  "bundled": true
}